{
  "name": "@monorepo/api",
  "version": "0.0.1",
  "private": true,
  "description": "API layer with Hono",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:build": "tsc && node dist/server.js",
    "worker": "tsx watch src/worker.ts",
    "worker:build": "tsc && node dist/worker.js",
    "lint": "eslint src",
    "format": "prettier --write src",
    "bootstrap-admin": "tsx src/scripts/bootstrap-admin.ts",
    "seed-demo-login": "tsx src/scripts/seed-demo-login.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "latest",
    "@hono/node-server": "latest",
    "@hono/zod-validator": "latest",
    "@monorepo/core": "workspace:*",
    "@monorepo/db": "workspace:*",
    "better-auth": "latest",
    "csv-parse": "latest",
    "drizzle-orm": "latest",
    "hono": "latest",
    "iconv-lite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "dotenv": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
