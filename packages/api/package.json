{
  "name": "@monorepo/api",
  "version": "0.0.1",
  "private": true,
  "description": "API layer with Hono",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:build": "tsc && node dist/server.js",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "latest",
    "@hono/node-server": "latest",
    "@monorepo/core": "workspace:*",
    "@monorepo/db": "workspace:*",
    "better-auth": "latest",
    "hono": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
