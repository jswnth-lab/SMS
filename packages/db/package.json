{
  "name": "@monorepo/db",
  "version": "0.0.1",
  "private": true,
  "description": "Database layer with Drizzle ORM",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "drizzle-orm": "latest",
    "drizzle-kit": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
