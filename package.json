{
  "name": "monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo with pnpm and Turborepo",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@monorepo/api",
    "dev:web": "turbo run dev --filter=@monorepo/web",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "type-check": "turbo run type-check",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:generate": "turbo run db:generate --filter=@monorepo/db",
    "db:migrate": "turbo run db:migrate --filter=@monorepo/db",
    "db:seed": "turbo run db:seed --filter=@monorepo/db"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
