{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "interactive": true
    },
    "build": {
      "outputs": ["dist/**", ".next/**", "build/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "type-check": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "cache": false,
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "outputs": ["migrations/**"],
      "cache": false
    },
    "db:migrate": {
      "outputs": ["migrations/**"],
      "cache": false
    },
    "db:seed": {
      "outputs": [],
      "cache": false,
      "dependsOn": ["build"]
    },
    "db:rls-verify": {
      "outputs": [],
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
