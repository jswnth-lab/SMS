# Database
# Owner connection - used by drizzle-kit generate/migrate and db:seed
# (a Postgres superuser, so it bypasses row-level security by design).
DATABASE_URL="postgresql://user:password@localhost:5432/monorepo_dev"
# Restricted app_rw connection - used by the running API, subject to the
# row-level security policies in packages/db/migrations/0005_row_level_security.sql.
APP_DATABASE_URL="postgresql://app_rw:change-me@localhost:5432/monorepo_dev"

# API
API_PORT=3001
API_BASE_URL="http://localhost:3001"

# Web App
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment
NODE_ENV="development"
